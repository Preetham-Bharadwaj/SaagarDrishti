# =============================================================================
# SaagarDrishti - Root .gitignore
# =============================================================================

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
.env.local
.env.*.local
*.env
*.key
*.pem
*.cert
*.pfx
secrets.*

# Scratch / Local Diagnostic Dumps
scratch_excluded.txt
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Node & Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
.vercel/
*.tsbuildinfo
next-env.d.ts

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
backend/.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*-checkpoint.ipynb

# Data Directories (preserve structure, ignore large local data)
backend/data/raw/*
!backend/data/raw/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep

# IDEs & Operating System Artifacts
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
