# -----------------------------------------------------------------------------
# SaagarDrishti Environment Configuration Template
# Copy this file to '.env' and fill in the values for your local environment.
# -----------------------------------------------------------------------------

# Application Settings
APP_NAME=SaagarDrishti
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# Data Source Configurations (Placeholders)
INCOIS_API_BASE_URL=
INCOIS_API_KEY=

# LLM & Multi-Agent Configurations (Placeholders)
AGENT_MODEL_NAME=
AGENT_API_KEY=

# Geospatial & Storage Settings (Placeholders)
DATA_DIR=data/
DATABASE_URL=

# Copernicus Marine Data Store (CMEMS) Credentials
# Register for free at https://data.marine.copernicus.eu/
# Do NOT commit your actual credentials into version control (.env is gitignored)
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
